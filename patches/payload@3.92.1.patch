@@ -0,0 +1,18 @@
+const failures = new WeakMap();
+const rollbacks = new WeakMap();
+export const recordGalleryCreateFailure = (error, evidence) => {
+    if (!error || (typeof error !== 'object' && typeof error !== 'function')) return;
+    const entries = failures.get(error) || [];
+    entries.push(Object.freeze(evidence));
+    failures.set(error, entries);
+};
+export const recordGalleryRollback = (error, receipt) => {
+    if (!error || (typeof error !== 'object' && typeof error !== 'function') || !receipt || typeof receipt !== 'object') return;
+    const entries = rollbacks.get(error) || [];
+    entries.push(receipt);
+    rollbacks.set(error, entries);
+};
+export const readGalleryCreateFailure = (error, req) => {
+    const attempt = failures.get(error)?.find((entry) => entry.req === req && entry.owned);
+    return attempt ? Object.freeze({ ...attempt, borrowedMediaFailure: failures.get(error).some((entry) => entry.collection === 'clinicMedia' && !entry.owned && entry.transactionID === attempt.transactionID), rollbacks: Object.freeze([...(rollbacks.get(error) || [])]) }) : undefined;
+};
