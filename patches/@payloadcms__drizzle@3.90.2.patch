+const uniqueFailures = new WeakMap();
+const rollbacks = new WeakMap();
+export const recordGalleryUniqueFailure = (error, evidence) => {
+    uniqueFailures.set(error, Object.freeze(evidence));
+};
+export const readGalleryUniqueFailure = (error) => uniqueFailures.get(error);
+export const completeGalleryRollback = (adapter, transactionID) => {
+    const receipt = Object.freeze({});
+    rollbacks.set(receipt, Object.freeze({ adapter, transactionID }));
+    return receipt;
+};
+export const readGalleryRollback = (receipt) => rollbacks.get(receipt);
+
+export const installGalleryProvenanceReader = (adapter) => {
+    if (Object.hasOwn(adapter, 'galleryUploadProvenance')) return;
+    Object.defineProperty(adapter, 'galleryUploadProvenance', {
+        value: Object.freeze({
+            version: 'native-gallery-abort-v1',
+            readUniqueFailure: (error) => { const evidence = readGalleryUniqueFailure(error); return evidence?.adapter === adapter ? evidence : undefined; },
+            readRollback: (receipt) => { const evidence = readGalleryRollback(receipt); return evidence?.adapter === adapter ? evidence : undefined; }
+        }),
+        writable: false, configurable: false, enumerable: false
+    });
+};
